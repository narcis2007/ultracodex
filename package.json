{
  "name": "ultracodex-workspace",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Development workspace for the ultracodex Claude Code plugin (tests and build tooling; not shipped).",
  "scripts": {
    "test": "node --test --test-concurrency=4 \"tests/*.test.mjs\"",
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check && node --test --test-concurrency=4 \"tests/*.test.mjs\"",
    "preflight": "node plugins/ultracodex/scripts/codex-node.mjs preflight --pretty",
    "dev": "claude --plugin-dir plugins/ultracodex --settings tools/dev-settings.json"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0"
}
